{
  "name": "ai-image-gen",
  "private": true,
  "version": "1.2.3",
  "description": "ChatDKH - Ứng dụng trò chuyện AI với khả năng tạo hình ảnh từ mô tả văn bản, sử dụng AI của Dakuho.",
  "author": "Dakuho-Dev",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always",
    "preview": "vite preview",
    "electron:dev": "vite"
  },
  "build": {
    "appId": "com.aigen.app",
    "productName": "ChatDKH",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Dakuho-Dev",
        "repo": "ai-image-gen"
      }
    ]
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "openai": "^4.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
